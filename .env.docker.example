# Commit as: Trading_Dashboard_App/.env.docker.example
# Copy to .env next to docker-compose.yml. Optional — the defaults are fine on
# a stock Raspberry Pi OS install. This file holds NO secrets; your Schwab keys
# go in on the dashboard's Settings page and never touch this file.

# Your timezone, so market-hours logic and on-screen timestamps are right.
TZ=America/Denver

# Run the bridge as you rather than root, so files it writes into data/ and
# schwab-bridge/ stay editable from your own shell.
# Find yours with:  id -u   and   id -g
# On Raspberry Pi OS the first user is almost always 1000/1000.
UID=1000
GID=1000

# Where the bridge checkout lives, relative to this file. Leave unset when it
# is the sibling folder ../schwab-bridge (the layout the guide describes).
# BRIDGE_DIR=../schwab-bridge
